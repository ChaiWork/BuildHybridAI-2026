rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInCrew() {
      return request.auth != null;
    }

    // Never permit private crew mental-health journals to be written to cloud storage.
    function notPrivateJournal() {
      return !('is_private_journal' in request.resource.data)
        || request.resource.data.is_private_journal == false;
    }

    // Store-and-forward Flight Surgeon consultation packets (queued offline, synced on link restore)
    match /consult_packets/{packetId} {
      allow read: if isSignedInCrew();
      allow create, update: if isSignedInCrew() && notPrivateJournal();
    }

    // Cross-platform EVA field logs synced between Native Android EVA Companion and Web Habitat Console
    match /eva_logs/{logId} {
      allow read: if isSignedInCrew();
      allow create, update: if isSignedInCrew() && notPrivateJournal();
    }

    // Non-private crew physiological & environmental telemetry snapshots
    match /crew_telemetry/{recordId} {
      allow read: if isSignedInCrew();
      allow create, update: if isSignedInCrew() && notPrivateJournal();
    }
  }
}

