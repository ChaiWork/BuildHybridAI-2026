# ============================================================================
# TARS Care — Firebase AI Logic Hybrid Inference & Cloud Suite Configuration
# Copy to frontend/.env.local (never commit real secrets or debug tokens).
# Standard Firebase Web config values are protected at runtime by App Check
# and Firestore Security Rules (see ../firestore.rules).
# ============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (Required for Firebase AI Logic)
# Production: set your reCAPTCHA v3 or Enterprise site key.
# Local / Judge Testing: set VITE_FIREBASE_APPCHECK_DEBUG=true to log a debug
# token in DevTools Console (or paste a registered debug token string locally).
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
VITE_FIREBASE_RECAPTCHA_ENTERPRISE=false
VITE_FIREBASE_APPCHECK_DEBUG=true

# Optional: Default cloud fallback Gemini model for Firebase AI Logic
VITE_FIREBASE_CLOUD_MODEL=gemini-3.5-flash-lite

